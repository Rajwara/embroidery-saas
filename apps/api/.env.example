# Local dev defaults match docker-compose.yml
# DATABASE_URL is the restricted app_user role (RLS applies to it) — the app runs as this.
DATABASE_URL=postgresql+psycopg://app_user:app_user_local_dev@localhost:5432/embroidery_saas
# MIGRATIONS_DATABASE_URL is the table-owning role — Alembic runs as this (RLS is bypassed
# for it by design, since it owns the tables it creates). Never used by the running API.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/embroidery_saas
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RESEND_API_KEY=
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000
